# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Cloud (Free Tier) — https://cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=pakistan_tourism_notes

# Neon Serverless Postgres — https://neon.tech
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/pakistan_tourism?sslmode=require

# CORS: the deployed frontend origin
FRONTEND_ORIGIN=http://localhost:3000
